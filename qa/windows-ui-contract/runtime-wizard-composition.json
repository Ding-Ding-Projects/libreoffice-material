{
  "schema_version": 1,
  "contract": "material-runtime-wizard-composition",
  "platform": "windows",
  "status": "source-implemented",
  "runtime_verified": false,
  "surface": "vcl/uiconfig/ui/wizard.ui",
  "owner": "vcl",
  "inventory_id": "unassigned",
  "theme_activation": {
    "environment_variable": "VCL_FILE_WIDGET_THEME",
    "value": "material",
    "high_contrast_precedence": true
  },
  "shell": {
    "root_class": "GtkAssistant",
    "root_id": "Wizard",
    "modal": true,
    "title_source": "runtime",
    "forbidden_properties": [
      "border-width"
    ]
  },
  "runtime_page_host": {
    "source": "vcl/source/app/salvtables.cxx",
    "function": "weld::Container* SalInstanceAssistant::append_page(const OUString& rIdent)",
    "metric_source": "vcl/uiconfig/theme_definitions/material/definition.xml",
    "metric": "space-list-entry",
    "metric_value": 12,
    "required_markers": [
      "VclPtrInstance<VclGrid> xGrid(xPage);",
      "lcl_materialWizardPageSpacing()",
      "xGrid->set_row_spacing(*oSpacing);",
      "xGrid->set_column_spacing(*oSpacing);",
      "xGrid->set_margin_start(*oSpacing);",
      "xGrid->set_margin_end(*oSpacing);",
      "xGrid->set_margin_top(*oSpacing);",
      "xGrid->set_margin_bottom(*oSpacing);"
    ]
  },
  "forward_actions": {
    "source": "vcl/source/control/roadmapwizard.cxx",
    "function": "void RoadmapWizard::implConstruct()",
    "primary_ids": [
      "next",
      "finish"
    ],
    "required_markers": [
      "m_pNextPage->set_id(u\"next\"_ustr);",
      "m_pNextPage->setAction(true);",
      "m_pFinish->set_id(u\"finish\"_ustr);",
      "m_pFinish->setAction(true);"
    ]
  },
  "preserved_semantics": [
    "runtime-title",
    "runtime-page-order",
    "roadmap-navigation",
    "help-previous-next-finish-cancel-responses",
    "modal-decision-flow",
    "forced-colors-precedence"
  ]
}
