{
  "schema_version": 1,
  "contract": "material-titlebar-composition",
  "platform": "windows",
  "definition_file": "vcl/uiconfig/theme_definitions/material/definition.xml",
  "chapter": "docs/design/05-navigation.md",
  "chapter_section": "7",
  "theme_flag": "VCL_FILE_WIDGET_THEME",
  "status": "source-implemented",
  "runtime_verified": false,
  "notes": "WIN-NAV-007. Material title metrics and active/deactive slots are now consumed by both title-bar owners. VCL-rendered normal, small, and tear-off title bands select active/deactive fill, text, border, and caption-symbol colors from StyleSettings. Windows top-level frames pass those same colors to DWM through caption, border, and text attributes and refresh them on non-client activation. The Material guard is exact, high contrast resets all three DWM attributes to DWMWA_COLOR_DEFAULT, and DWM retains frame geometry, caption buttons, hit testing, DPI, snapping, system menus, close-hover signaling, and accessibility. Source evidence only: native compilation and active/inactive runtime captures remain separate gates.",
  "metrics": [
    {"name": "height-window-title", "value": "18"},
    {"name": "height-floating-title", "value": "14"}
  ],
  "settings": [
    {"name": "titleHeight", "value": "@height-window-title"},
    {"name": "floatTitleHeight", "value": "@height-floating-title"}
  ],
  "style_slots": [
    {"slot": "activeColor", "token": "@primary"},
    {"slot": "activeTextColor", "token": "@on-primary"},
    {"slot": "activeBorderColor", "token": "@primary"},
    {"slot": "deactiveColor", "token": "@disabled-container"},
    {"slot": "deactiveTextColor", "token": "@outline"},
    {"slot": "deactiveBorderColor", "token": "@outline-variant"}
  ],
  "palette_colors": [
    "primary",
    "on-primary",
    "disabled-container",
    "outline",
    "outline-variant"
  ],
  "owner": {
    "source": "vcl/source/gdi/FileDefinitionWidgetDraw.cxx",
    "note": "The shared file-theme loader pushes Material metrics and frame-activation colors into StyleSettings before either rendering owner consumes them.",
    "markers": [
      "SetTitleHeight(",
      "SetFloatTitleHeight(",
      "SetActiveColor(pDefinitionStyle->maActiveColor)",
      "SetActiveTextColor(pDefinitionStyle->maActiveTextColor)",
      "SetActiveBorderColor(pDefinitionStyle->maActiveBorderColor)",
      "SetDeactiveColor(pDefinitionStyle->maDeactiveColor)",
      "SetDeactiveTextColor(pDefinitionStyle->maDeactiveTextColor)",
      "SetDeactiveBorderColor(pDefinitionStyle->maDeactiveBorderColor)"
    ]
  },
  "consumption": {
    "status": "source-implemented",
    "material_guard": "VCL_FILE_WIDGET_THEME=material",
    "high_contrast_policy": "system-owned",
    "activation_source": "WM_NCACTIVATE",
    "renderers": [
      {
        "name": "vcl-floating-title-bands",
        "source": "vcl/source/window/brdwin.cxx",
        "required_markers": [
          "IsMaterialTitleBarTheme()",
          "!rStyleSettings.GetHighContrastMode()",
          "BorderWindowTitleType::Normal",
          "BorderWindowTitleType::Small",
          "BorderWindowTitleType::Tearoff",
          "pBorderWindow->mbDisplayActive",
          "rStyleSettings.GetActiveColor()",
          "rStyleSettings.GetDeactiveColor()",
          "rStyleSettings.GetActiveTextColor()",
          "rStyleSettings.GetDeactiveTextColor()",
          "rStyleSettings.GetActiveBorderColor()",
          "rStyleSettings.GetDeactiveBorderColor()",
          "aTitleTextColor"
        ]
      },
      {
        "name": "windows-dwm-top-level-chrome",
        "source": "vcl/win/window/salframe.cxx",
        "required_markers": [
          "UpdateMaterialTitleBarColors(HWND hWnd, bool bActive)",
          "IsMaterialTitleBarTheme()",
          "rStyleSettings.GetHighContrastMode()",
          "DWMWA_COLOR_DEFAULT",
          "DWMWA_CAPTION_COLOR",
          "DWMWA_BORDER_COLOR",
          "DWMWA_TEXT_COLOR",
          "DwmSetWindowAttribute(hWnd, DWMWA_CAPTION_COLOR, &nDefaultColor,",
          "DwmSetWindowAttribute(hWnd, DWMWA_BORDER_COLOR, &nDefaultColor,",
          "DwmSetWindowAttribute(hWnd, DWMWA_TEXT_COLOR, &nDefaultColor,",
          "DwmSetWindowAttribute(hWnd, DWMWA_CAPTION_COLOR, &nCaptionColor,",
          "DwmSetWindowAttribute(hWnd, DWMWA_BORDER_COLOR, &nBorderColor,",
          "DwmSetWindowAttribute(hWnd, DWMWA_TEXT_COLOR, &nTextColor,",
          "rStyleSettings.GetActiveColor()",
          "rStyleSettings.GetDeactiveColor()",
          "rStyleSettings.GetActiveTextColor()",
          "rStyleSettings.GetDeactiveTextColor()",
          "rStyleSettings.GetActiveBorderColor()",
          "rStyleSettings.GetDeactiveBorderColor()",
          "case WM_NCACTIVATE:",
          "UpdateMaterialTitleBarColors(hWnd, wParam != FALSE)"
        ],
        "forbidden_markers": [
          "case WM_NCHITTEST:",
          "DwmExtendFrameIntoClientArea("
        ]
      }
    ],
    "os_owned": [
      "non-client frame geometry",
      "caption buttons and close-hover signal",
      "hit testing and drag/snap gestures",
      "Alt+Space and Alt+F4 behavior",
      "DPI and accessibility semantics"
    ]
  }
}
